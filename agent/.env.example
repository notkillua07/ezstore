# Local development configuration for the quotation agent.
# Copy to agent/.env (git-ignored). Used by `agents-cli playground` / `agents-cli eval run`.

# Model credentials — choose ONE:
# A. Google AI Studio API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# B. Vertex AI (run `gcloud auth application-default login` first)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global

AGENT_MODEL=gemini-3.8-flash

# MCP Server started by `docker compose up` (host port 8010 -> container 8000)
MCP_URL=http://localhost:8010/mcp
