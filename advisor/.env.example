# Local development for the sales advisor (copy to advisor/.env, git-ignored).
# Model credentials — choose ONE:
# A. Google AI Studio: GEMINI_API_KEY=
# B. Vertex AI (gcloud auth application-default login first):
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
AGENT_MODEL=gemini-3.8-flash

# Where the quotation agent serves A2A (local: run it on port 8001; Docker: http://agent:8080)
QUOTATION_AGENT_URL=http://127.0.0.1:8001
